# Copy to .env.prod (gitignored) and fill in. Used by docker-compose.prod.yml
# for the postgres container and the migrate step's DATABASE_URL.
#
# These MUST match data.database.* in configs/prod/config.yaml.
POSTGRES_USER=feedium
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=feedium

# AES-256-GCM key for the Telegram session file (base64-encoded 32 bytes).
# Generate: openssl rand -base64 32
# Without this the session is stored unencrypted — set it before authorizing.
TG_SESSION_KEY=GENERATE_WITH_OPENSSL_RAND
